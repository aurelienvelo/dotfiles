#!/bin/sh
set -euo pipefail

# Applique la configuration chezmoi en s'assurant que Bitwarden est déverrouillé.
# Les templates privés (oci, kube, sops, ssh) lisent le vault : bw doit être
# accessible, sinon chezmoi échoue dès le rendu des templates.

if ! command -v bw >/dev/null 2>&1; then
    echo "ERREUR: bitwarden-cli (bw) absent."
    echo "Lancez d'abord: $HOME/.local/share/chezmoi/home/.chezmoiscripts/.install-password-manager.sh"
    exit 1
fi

status="$(bw status --nointeraction 2>/dev/null | jq -r '.status // "locked"' 2>/dev/null || echo locked)"

case "$status" in
    unlocked)
        ;;
    locked)
        echo "Bitwarden est verrouillé. Déverrouillage (mot de passe maître)..."
        export BW_SESSION="$(bw unlock --raw)"
        ;;
    unauthenticated)
        echo "Bitwarden non connecté. Connexion (email + mot de passe maître)..."
        export BW_SESSION="$(bw login --raw)"
        ;;
    *)
        echo "ERREUR: statut Bitwarden inattendu: '$status'"
        exit 1
        ;;
esac

exec chezmoi apply "$@"