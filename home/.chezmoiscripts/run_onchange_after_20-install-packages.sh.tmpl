{{ if eq .chezmoi.os "linux" -}}
#!/bin/bash
set -euo pipefail

{{ template "pkg-list.sh" . }}
mapfile -t packages < <(desired_packages)

if [ ${#packages[@]} -gt 0 ]; then
    # -Syu obligatoire :
    #  - sans -y : bases synchrones périmées → 404 sur les paquets
    #    reconstruits et purgés des miroirs (ex: seclists)
    #  - sans -u : installation partielle, non supportée sous Arch
    paru -Syu --noconfirm --needed "${packages[@]}"
fi
{{ end -}}


{{ if eq .chezmoi.os "darwin" -}}
#!/bin/bash
set -euo pipefail

brew bundle --file=/dev/stdin <<EOF
{{ range dig "brews" (list) .packages.darwin -}}
brew {{ . | quote }}
{{ end -}}
{{ range dig "casks" (list) .packages.darwin -}}
cask {{ . | quote }}
{{ end -}}
EOF
{{ end -}}