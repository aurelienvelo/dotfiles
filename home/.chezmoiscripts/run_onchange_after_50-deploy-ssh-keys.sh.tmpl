{{ if eq .chezmoi.os "linux" -}}
#!/bin/bash
set -euo pipefail

# --- déclenche run_onchange_ si le registre ou la liste d'hôtes change ---
{{ range (glob (printf "%s/ssh_pubkeys_registry/*.pub" .chezmoi.sourceDir)) -}}
# {{ base . }}: {{ include . | sha256sum }}
{{ end -}}
# hosts: {{ .ssh.hosts | toJson | sha256sum }}
# --- fin ---

REGISTRY="{{ .chezmoi.sourceDir }}/ssh_pubkeys_registry"
shopt -s nullglob
keys=("$REGISTRY"/*.pub)
[ ${#keys[@]} -gt 0 ] || exit 0

# Une seule connexion par hôte : les clés passent par stdin et le côté
# distant n'ajoute que les lignes absentes. Aucune clé n'est interpolée dans
# la commande distante, donc pas de souci de quoting.
# Note : run_onchange_ ; un hôte injoignable (laptop hors LAN) ne sera
# retenté qu'au prochain changement du registre.
add_keys='umask 077; mkdir -p ~/.ssh; touch ~/.ssh/authorized_keys
while IFS= read -r k; do
    [ -n "$k" ] || continue
    grep -qxF "$k" ~/.ssh/authorized_keys || printf "%s\n" "$k" >> ~/.ssh/authorized_keys
done'

{{ range .ssh.hosts -}}
echo "Clés autorisées sur {{ .user }}@{{ .hostname }}..."
cat "${keys[@]}" | ssh -o BatchMode=yes -o ConnectTimeout=5 -o StrictHostKeyChecking=accept-new \
    {{ printf "%s@%s" .user .hostname | quote }} "$add_keys" \
    || echo "  → injoignable ou accès refusé, ignoré"
{{ end -}}
{{ end -}}
