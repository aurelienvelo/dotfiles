{{ if and (eq .chezmoi.os "linux") (dig "pentest" false .) -}}
#!/bin/bash
set -euo pipefail

# Dépôt BlackArch. Script run_ (chaque apply) et non run_once_ : un run_once_
# qui sort en 0 faute de TTY est enregistré comme exécuté et ne serait jamais
# retenté. Le test ci-dessous rend le script quasi gratuit une fois installé.
#
# strap.sh ajoute « [blackarch] » + « Include = /etc/pacman.d/blackarch-mirrorlist »
# dans pacman.conf (l'URL blackarch.org n'y figure pas).
if grep -q '^\[blackarch\]' /etc/pacman.conf; then
    exit 0
fi

if [ ! -t 0 ]; then
    echo "[blackarch] Mode non interactif : installation reportée au prochain 'chezmoi apply' dans un terminal."
    echo "[blackarch] Ou manuellement : voir https://blackarch.org/downloads.html (vérifier le SHA1 avant d'exécuter strap.sh)"
    exit 0
fi

echo "[blackarch] Installation du dépôt BlackArch..."
tmp="$(mktemp)"
trap 'rm -f "$tmp"' EXIT
# Téléchargé, vérifié, puis exécuté (jamais curl | bash) : ni un transfert
# tronqué ni un strap.sh modifié ne sont lancés en root. Empreinte épinglée
# dans .chezmoidata/blackarch.yaml.
curl -fsSL https://blackarch.org/strap.sh -o "$tmp"
want={{ .blackarch.strap_sha256 | quote }}
got="$(sha256sum "$tmp" | cut -d' ' -f1)"
if [ "$got" != "$want" ]; then
    echo "[blackarch] strap.sh ne correspond pas à l'empreinte épinglée : exécution refusée." >&2
    echo "[blackarch]   attendu : $want" >&2
    echo "[blackarch]   obtenu  : $got (SHA1 : $(sha1sum "$tmp" | cut -d' ' -f1))" >&2
    echo "[blackarch] Comparer ce SHA1 à celui publié sur https://blackarch.org/downloads.html," >&2
    echo "[blackarch] puis mettre à jour strap_sha256 dans .chezmoidata/blackarch.yaml." >&2
    exit 1
fi
sudo bash "$tmp"
{{ end -}}
